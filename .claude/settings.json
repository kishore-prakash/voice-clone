{
  "permissions": {
    "allow": [
      "Bash(uv run python tests/test_text.py)",
      "Bash(uv run voiceclone:*)",
      "Bash(uv sync)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-core.sh"
          }
        ]
      }
    ]
  }
}
